<?xml version="1.0" encoding="utf-8"?>
<mdscript name="X4LAN_Health" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="md.xsd">
 <!-- Victim-pilot health authority (ui/health_game.lua). Pilot side: 10 Hz readback of the occupied
      co-op ship. Host side: applies the pilot's values to its proxy with a 2% hull floor, so only
      a reported lethal value reaches the 1.01% life threshold of x4lan_life.xml. -->
 <cues>
  <cue name="Session" namespace="this">
   <conditions><event_ui_triggered screen="'X4LAN_Health'" control="'Setup'"/></conditions>
   <actions>
    <set_value name="$arena" exact="md.X4LAN_Bubble.Arena"/>
    <!-- Read by the guest WORLD Apply guard: true while this machine owns and pilots ship i. -->
    <set_value name="$arena.$healthOwn" exact="[false,false]"/>
    <raise_lua_event name="'X4LAN_Health.Ready'"/>
    <debug_text text="'[X4LAN] HEALTH_SETUP host=%s'.[$arena.$host]"/>
   </actions>
   <cues>
    <cue name="Own" instantiate="true" checkinterval="0.1s"><conditions><check_value value="@player.occupiedship.isoperational"/></conditions><actions>
     <set_value name="$e" exact="$arena.$ships.indexof.{player.occupiedship}"/>
     <do_if value="$e gt 0">
      <raise_lua_event name="'X4LAN_Health.Own'" param="'%s|%s|%s'.[$e,player.occupiedship.hullpercentage,player.occupiedship.shieldpercentage]"/>
     </do_if>
    </actions></cue>
    <cue name="Owned" instantiate="true"><conditions><event_ui_triggered screen="'X4LAN_Health'" control="'Owned'"/></conditions><actions>
     <set_value name="$arena.$healthOwn.{event.param3.$entity}" exact="event.param3.$own"/>
     <debug_text text="'[X4LAN] HEALTH_OWNED entity=%s own=%s'.[event.param3.$entity,event.param3.$own]"/>
    </actions></cue>
    <cue name="Apply" instantiate="true"><conditions><event_ui_triggered screen="'X4LAN_Health'" control="'Apply'"/><check_value value="$arena.$host"/></conditions><actions>
     <set_value name="$a" exact="event.param3"/><set_value name="$ship" exact="$arena.$ships.{$a.$entity}"/>
     <do_if value="@$ship.isoperational and not $arena.$dead.{$a.$entity}">
      <do_if value="$a.$hull le 1.01">
       <set_object_min_hull object="$ship" exact="1"/>
       <debug_text text="'[X4LAN] HEALTH_LETHAL entity=%s hull=%s'.[$a.$entity,$a.$hull]"/>
      </do_if>
      <do_else><set_object_min_hull object="$ship" exact="2"/></do_else>
      <set_object_hull object="$ship" exact="$a.$hull"/>
      <set_object_shield object="$ship" exact="$a.$shield"/>
     </do_if>
    </actions></cue>
    <cue name="Release" instantiate="true"><conditions><event_ui_triggered screen="'X4LAN_Health'" control="'Release'"/><check_value value="$arena.$host"/></conditions><actions>
     <set_value name="$ship" exact="$arena.$ships.{event.param3.$entity}"/>
     <do_if value="@$ship.isoperational"><set_object_min_hull object="$ship" exact="1"/></do_if>
     <debug_text text="'[X4LAN] HEALTH_RELEASE entity=%s'.[event.param3.$entity]"/>
    </actions></cue>
   </cues>
  </cue>
 </cues>
</mdscript>
