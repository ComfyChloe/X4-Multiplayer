<?xml version="1.0" encoding="utf-8"?>
<mdscript name="X4LAN_Damage" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="md.xsd">
 <!-- Shooter-confirmed hits (HIT2, ui/damage_game.lua attributes them). This script only reports
      native attack/damage events of the co-op ships and LAN targets and applies host requests.
      Victims: 1-2 co-op ships, 3-4 LAN targets. Hull events of child components are excluded. -->
 <cues>
  <cue name="Session" namespace="this">
   <conditions><event_ui_triggered screen="'X4LAN_Damage'" control="'Setup'"/></conditions>
   <actions>
    <set_value name="$arena" exact="md.X4LAN_Bubble.Arena"/>
    <set_value name="$victims" exact="[$arena.$ships.{1},$arena.$ships.{2},@$arena.$targets.{1},@$arena.$targets.{2}]"/>
    <create_group groupname="$group"/>
    <do_all exact="4" counter="$i"><do_if value="$victims.{$i}.exists"><add_to_group groupname="$group" object="$victims.{$i}"/></do_if></do_all>
    <raise_lua_event name="'X4LAN_Damage.Ready'"/>
    <debug_text text="'[X4LAN] DMG_SETUP host=%s victims=%s'.[$arena.$host,$group.count]"/>
   </actions>
   <cues>
    <cue name="Attacked" instantiate="true"><conditions><event_object_attacked group="$group"/></conditions><actions>
     <set_value name="$v" exact="$victims.indexof.{event.object}"/>
     <do_if value="$v gt 0">
      <raise_lua_event name="'X4LAN_Damage.Attacked'" param="'%s|%s|%s|%s'.[$v,$arena.$ships.indexof.{event.param},if event.param == player.occupiedship then 1 else 0,player.age / 1s]"/>
     </do_if>
    </actions></cue>
    <cue name="ShieldDamaged" instantiate="true"><conditions><event_object_shield_damaged group="$group"/></conditions><actions>
     <set_value name="$v" exact="$victims.indexof.{event.object}"/>
     <do_if value="$v gt 0 and event.param3 gt 0">
      <raise_lua_event name="'X4LAN_Damage.Damaged'" param="'%s|s|%s|%s'.[$v,event.param3,player.age / 1s]"/>
     </do_if>
    </actions></cue>
    <cue name="HullDamaged" instantiate="true"><conditions><event_object_hull_damaged group="$group"/></conditions><actions>
     <set_value name="$v" exact="$victims.indexof.{event.object}"/>
     <do_if value="$v gt 0 and event.param == event.object and event.param3 gt 0">
      <raise_lua_event name="'X4LAN_Damage.Damaged'" param="'%s|h|%s|%s'.[$v,event.param3,player.age / 1s]"/>
     </do_if>
    </actions></cue>
    <!-- Host: give back the damage of hits by the replayed remote ship; its pilot reports them. -->
    <cue name="Undo" instantiate="true"><conditions><event_ui_triggered screen="'X4LAN_Damage'" control="'Undo'"/><check_value value="$arena.$host"/></conditions><actions>
     <set_value name="$a" exact="event.param3"/><set_value name="$o" exact="$victims.{$a.$victim}"/>
     <do_if value="@$o.isoperational">
      <do_if value="$a.$shield gt 0 and $o.maxshield gt 0"><set_object_shield object="$o" exact="[100, ($o.shield + $a.$shield) * 100.0 / $o.maxshield].min"/></do_if>
      <do_if value="$a.$hull gt 0 and $o.maxhull gt 0"><set_object_hull object="$o" exact="[100, ($o.hull + $a.$hull) * 100.0 / $o.maxhull].min"/></do_if>
      <debug_text text="'[X4LAN] DMG_UNDO victim=%s shield=%s hull=%s'.[$a.$victim,$a.$shield,$a.$hull]"/>
     </do_if>
    </actions></cue>
    <!-- Host: apply the increase of a guest's cumulative HIT2 totals natively. -->
    <cue name="Apply" instantiate="true"><conditions><event_ui_triggered screen="'X4LAN_Damage'" control="'Apply'"/><check_value value="$arena.$host"/></conditions><actions>
     <set_value name="$d" exact="event.param3.$values"/>
     <do_all exact="4" counter="$i">
      <set_value name="$o" exact="$victims.{$i}"/>
      <do_if value="@$o.isoperational and ($d.{$i * 2 - 1} gt 0 or $d.{$i * 2} gt 0)">
       <do_if value="$d.{$i * 2 - 1} gt 0 and $o.maxshield gt 0"><set_object_shield object="$o" exact="[0, ($o.shield - $d.{$i * 2 - 1}) * 100.0 / $o.maxshield].max"/></do_if>
       <do_if value="$d.{$i * 2} gt 0 and $o.maxhull gt 0">
        <do_if value="$i ge 3 and $o.hull - $d.{$i * 2} le 0"><destroy_object object="$o" explosion="true"/></do_if>
        <do_else><set_object_hull object="$o" exact="[0, ($o.hull - $d.{$i * 2}) * 100.0 / $o.maxhull].max"/></do_else>
       </do_if>
       <debug_text text="'[X4LAN] DMG_APPLY entity=%s victim=%s shield=%s hull=%s'.[event.param3.$entity,$i,$d.{$i * 2 - 1},$d.{$i * 2}]"/>
      </do_if>
     </do_all>
    </actions></cue>
   </cues>
  </cue>
 </cues>
</mdscript>
