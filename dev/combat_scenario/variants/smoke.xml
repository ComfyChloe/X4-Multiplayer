<?xml version="1.0" encoding="utf-8"?>
<!-- Combat scenario variant "smoke": a small, short fight to check the fixture end to end. -->
<mdscript name="X4MP_CombatVariant" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="md.xsd">
  <cues>
    <library name="Config">
      <actions>
        <set_value name="$Variant" exact="'smoke'"/>
        <set_value name="$WarmupS" exact="20s"/>
        <set_value name="$SettleS" exact="5s"/>
        <set_value name="$WindowS" exact="30s"/>
        <set_value name="$A_Macros" exact="[macro.ship_arg_s_fighter_01_a_macro, macro.ship_arg_m_frigate_01_a_macro]"/>
        <set_value name="$A_Counts" exact="[5, 1]"/>
        <set_value name="$B_Macros" exact="[macro.ship_xen_s_fighter_01_a_macro, macro.ship_xen_m_corvette_01_a_macro]"/>
        <set_value name="$B_Counts" exact="[5, 1]"/>
        <set_value name="$Columns" exact="[5, 1]"/>
        <set_value name="$Spacing" exact="[150m, 600m]"/>
        <set_value name="$Depth" exact="[0m, 1200m]"/>
      </actions>
    </library>
  </cues>
</mdscript>
