<?xml version="1.0" encoding="utf-8"?>
<!-- Combat scenario variant "idle": the battle layout, but both sides are Argon and only wait.
     Every weapon and turret runs its update without a target (the idle Weapon Move path). -->
<mdscript name="X4MP_CombatVariant" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="md.xsd">
  <cues>
    <library name="Config">
      <actions>
        <set_value name="$Variant" exact="'idle'"/>
        <set_value name="$Hostile" exact="false"/>
        <set_value name="$B_Faction" exact="faction.argon"/>
        <set_value name="$B_PilotTags" exact="tag.aipilot"/>
        <set_value name="$B_Macros" exact="[macro.ship_arg_s_fighter_01_a_macro, macro.ship_arg_s_heavyfighter_02_a_macro, macro.ship_arg_m_frigate_01_a_macro, macro.ship_arg_l_destroyer_01_a_macro]"/>
        <set_value name="$B_Counts" exact="[30, 10, 2, 2]"/>
      </actions>
    </library>
  </cues>
</mdscript>
